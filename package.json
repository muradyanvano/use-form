{
  "name": "@muradyanvano/use-form",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Typed React 19 form hooks for nested fields, validation, and submission",
  "license": "MIT",
  "author": {
    "name": "Vano Muradyan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muradyanvano1995/use-form.git"
  },
  "homepage": "https://github.com/muradyanvano1995/use-form#readme",
  "bugs": {
    "url": "https://github.com/muradyanvano1995/use-form/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.8.0"
  },
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./resolvers/standard-schema": {
      "types": "./dist/resolvers/standard-schema/index.d.ts",
      "import": "./dist/resolvers/standard-schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:app": "tsc -b && vite build",
    "build:storybook": "storybook build --disable-telemetry",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "test:storybook": "vitest run src/stories",
    "test:storybook-browser": "node scripts/storybook-browser.mjs",
    "test:storybook-visual": "node scripts/storybook-visual.mjs",
    "preview": "vite preview --outDir dist-app",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --coverage --ui",
    "test:package": "node scripts/test-package.mjs",
    "test:ssr": "node scripts/test-ssr.mjs",
    "test:exports": "node scripts/test-exports.mjs",
    "size": "node scripts/measure-size.mjs",
    "docs:api": "typedoc",
    "pack:dry-run": "npm pack --dry-run",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "verify": "npm run lockfile:check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:coverage && npm run build:lib && npm run test:package && npm run test:ssr && npm run test:exports && npm run size && npm run docs:api && npm run build:storybook && npm run test:storybook && npm run pack:dry-run && npm run build:app",
    "verify:ci": "npm run verify && npx playwright install chromium && npm run test:storybook-browser && npm run test:storybook-visual"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "storybook": "^10.5.8",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
