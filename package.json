{
  "name": "react-hooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./resolvers/standard-schema": {
      "types": "./dist/resolvers/standard-schema/index.d.ts",
      "import": "./dist/resolvers/standard-schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:app": "tsc -b && vite build",
    "build:storybook": "storybook build --disable-telemetry",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "test:storybook": "vitest run src/stories",
    "test:storybook-visual": "node scripts/storybook-visual.mjs",
    "preview": "vite preview --outDir dist-app",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --coverage --ui",
    "test:package": "node scripts/test-package.mjs",
    "test:ssr": "node scripts/test-ssr.mjs",
    "test:exports": "node scripts/test-exports.mjs",
    "size": "node scripts/measure-size.mjs",
    "docs:api": "typedoc",
    "pack:dry-run": "npm pack --dry-run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:coverage && npm run build:lib && npm run test:package && npm run test:ssr && npm run test:exports && npm run size && npm run docs:api && npm run build:storybook && npm run test:storybook && npm run pack:dry-run && npm run build:app"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "storybook": "^10.5.8",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
